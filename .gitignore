# OS and editor files
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.ipynb_checkpoints/
.venv/
venv/
env/

# Base YOLO weights (AGPL-3.0; auto-downloaded by ultralytics CLI — not stored on remote)
yolov8n.pt

# YOLO training artifacts (exclude training runs but keep production model)
runs/
wandb/

# Exclude all models EXCEPT the production model
models/
!models/polyp_yolov8n_clean/
# Keep essential model files for end users
!models/polyp_yolov8n_clean/weights/
!models/polyp_yolov8n_clean/weights/best.pt
!models/polyp_yolov8n_clean/args.yaml
!models/polyp_yolov8n_clean/results.csv
# Exclude large training visualization files but keep the model
models/polyp_yolov8n_clean/*.png
models/polyp_yolov8n_clean/*.jpg

# Results directory — keep CSVs and JSON logs/metrics; exclude all video files and frame snapshots
results/*
!results/demo_detections.csv
!results/sample_inference/

# Phase 1 — YOLO-only outputs (no tracker)
!results/phase_1/
results/phase_1/*.mp4
!results/phase_1/*.csv

# Phase 2 SORT — YOLO + SORT + temporal pipeline
!results/phase_2_sort/
!results/phase_2_sort/logs/
results/phase_2_sort/videos/*.mp4
results/phase_2_sort/videos/frames/
!results/phase_2_sort/logs/*.csv
!results/phase_2_sort/logs/*.json
!results/phase_2_sort/metrics/
!results/phase_2_sort/metrics/*.json

# Phase 2 DeepSORT — YOLO + DeepSORT + temporal pipeline
!results/phase_2_deepsort/
!results/phase_2_deepsort/logs/
results/phase_2_deepsort/videos/*.mp4
results/phase_2_deepsort/videos/frames/
!results/phase_2_deepsort/logs/*.csv
!results/phase_2_deepsort/logs/*.json
!results/phase_2_deepsort/metrics/
!results/phase_2_deepsort/metrics/*.json

# Data directory - exclude all except test-set
data/*
!data/test-set/

# Thesis preparation documents - exclude from version control
thesis-prep-docs/

# Temporary files
tmp/
temp/
test_output/
copilot/
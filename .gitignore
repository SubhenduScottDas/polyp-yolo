# OS and editor files
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.ipynb_checkpoints/
.venv/
venv/
env/

# Base YOLO weights (AGPL-3.0; auto-downloaded by ultralytics CLI — not stored on remote)
yolov8n.pt

# YOLO training artifacts (exclude training runs but keep production model)
runs/
wandb/

# Exclude all models EXCEPT the production model
models/
!models/polyp_yolov8n_clean/
# Keep essential model files for end users
!models/polyp_yolov8n_clean/weights/
!models/polyp_yolov8n_clean/weights/best.pt
!models/polyp_yolov8n_clean/args.yaml
!models/polyp_yolov8n_clean/results.csv
# Exclude large training visualization files but keep the model
models/polyp_yolov8n_clean/*.png
models/polyp_yolov8n_clean/*.jpg

# Results directory — CSV data only; all .mp4 videos are regeneratable and excluded from remote
results/*
!results/demo_detections.csv
!results/sample_inference/
!results/*_detections.csv
!results/phase2/
results/phase2/*.mp4
!results/phase2/*.csv

# Data directory - exclude all except test-set
data/*
!data/test-set/

# Thesis preparation documents - exclude from version control
thesis-prep-docs/

# Temporary files
tmp/
temp/
test_output/
copilot/